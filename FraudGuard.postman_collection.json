              "name": "3. EARN setelah TOPUP — tapi tidak ada REDEEM",
              "request": {
                "method": "POST",
                "description": "❌ EXPECTED: isFlaggedFraud=true, triggered=[LifecycleCheck]\nUSER_A (yang tadi sudah TOPUP) coba langsung EARN tanpa REDEEM.\nLifecycleCheck: EARN butuh REDEEM, bukan TOPUP → TIDAK ADA REDEEM → FRAUD!\nIni mencegah user mengklaim point hanya dari topup tanpa booking produk.",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"step\":2,\"type\":\"EARN\",\"amount\":5000.00,\"nameOrig\":\"USER_A\",\"nameDest\":\"SYSTEM\",\"oldBalanceOrg\":500000.00,\"newBalanceOrig\":505000.00,\"tenantId\":\"MEMBERSHIP\"}",
