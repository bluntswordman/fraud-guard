                  ]
                }
              }
            },
            {
              "name": "4. EARN — User dapat point setelah trip selesai",
              "request": {
                "method": "POST",
                "description": "✅ EXPECTED: 200 OK, lifecycle CLEAN\nUSER_A dapat 5000 point reward. LifecycleCheck cek: USER_A punya REDEEM sebelumnya? YES → CLEAN.\nSaldo: 250rb → 255rb (konsisten). Ini mencegah klaim point tanpa pernah booking.",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"step\":3,\"type\":\"EARN\",\"amount\":5000.00,\"nameOrig\":\"USER_A\",\"nameDest\":\"SYSTEM\",\"oldBalanceOrg\":250000.00,\"newBalanceOrig\":255000.00,\"tenantId\":\"MEMBERSHIP\"}",
                  "options": {
