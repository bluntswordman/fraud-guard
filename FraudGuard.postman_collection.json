                  ],
                  "path": [
                    "api",
                    "transactions"
                  ]
                }
              }
            },
            {
              "name": "2. Balance Drain — Transfer habiskan saldo",
              "request": {
                "method": "POST",
                "description": "❌ EXPECTED: isFlaggedFraud=true, triggered=[BalanceAnomaly]\nCUSTOMER_VICTIM transfer seluruh saldo: oldBalance=5.1jt → newBalance=0.\nBalanceAnomaly deteksi pengurasan total → FRAUD!\nIni pola umum pencurian akun — penyerang transfer semua dana keluar.\nWebhook otomatis → BLOCK transaksi.",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"step\":1,\"type\":\"TRANSFER\",\"amount\":5100000.00,\"nameOrig\":\"CUSTOMER_VICTIM\",\"nameDest\":\"CUSTOMER_PENIPU\",\"oldBalanceOrg\":5100000.00,\"newBalanceOrig\":0,\"tenantId\":\"BANK\"}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{ingestion_url}}/api/transactions",
                  "host": [
                    "{{ingestion_url}}"
                  ],
                  "path": [
                    "api",
                    "transactions"
                  ]
                }
              }
            },
            {
              "name": "3. Balance Anomaly — Transfer besar dari saldo 0",
              "request": {
                "method": "POST",
                "description": "❌ EXPECTED: isFlaggedFraud=true, triggered=[BalanceAnomaly]\nAkun dengan saldo 0 tiba-tiba transfer >500rb. Tidak mungkin tanpa topup duluan.\nBalanceAnomaly: oldBalance=0 AND amount>500rb → FRAUD!\nIni pola akun fake yang langsung transfer besar tanpa histori.",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"step\":1,\"type\":\"TRANSFER\",\"amount\":1000000.00,\"nameOrig\":\"FAKE_ACCOUNT\",\"nameDest\":\"CUSTOMER_PENIPU\",\"oldBalanceOrg\":0,\"newBalanceOrig\":0,\"tenantId\":\"BANK\"}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{ingestion_url}}/api/transactions",
                  "host": [
                    "{{ingestion_url}}"
                  ],
                  "path": [
                    "api",
                    "transactions"
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. E-Commerce / E-Wallet — Non-Risky Transactions",
      "description": "=== RULES ===\nPAYMENT, CASH_IN, DEBIT → TIDAK dicek oleh strategy bawaan.\nSemua strategy (VelocityCheck, BalanceAnomaly, LifecycleCheck) akan SKIP.\nSelalu CLEAN — cocok untuk marketplace, e-wallet, subscription.\n\nTetap kirim transaksi agar masuk ke Stats dan Evaluation untuk analytics.",
