                "body": {
                  "mode": "raw",
                  "raw": "{\"step\":1,\"type\":\"EARN\",\"amount\":10000.00,\"nameOrig\":\"HACKER_2\",\"nameDest\":\"SYSTEM\",\"oldBalanceOrg\":0,\"newBalanceOrig\":10000.00,\"tenantId\":\"MEMBERSHIP\"}",
